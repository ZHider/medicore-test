# deploy/.env 的变量清单（**仅作文档**）。
#
# ⚠️ 直接复制本文件为 .env 是**不可用**的：
#    下面全是占位值，后端的 config.Validate() 会按特征拒绝它们
#    （含 "change-me"/"example" 等占位词、单一字符重复、短周期重复、连续升序），
#    启动时会报 "invalid config"。
#
# 正确做法是用生成器：
#     nub run stack:init
# 它用 node:crypto 生成密码学随机的密钥，并自动探测时区、空闲端口与 GOMODCACHE。
#
# ⚠️ 变量名一律 STACK_ 前缀，**不要改成 MEDICORE_***。
# 根目录还有一份开发用的 .env（含 MEDICORE_MYSQL_PASSWORD=medicore123），
# 而 nub 会自动加载它、Docker Compose 又遵循「shell 环境 > .env 文件」——
# 两个文件一旦同名，`nub run stack:*` 就会拿开发口令去起编排，
# 与数据卷里初始化的口令不匹配，后端直接 Access denied（实测踩到）。
# compose.yml 里"容器内的键名"仍是 MEDICORE_*（那是后端读的），
# 只有"插值来源"是 STACK_*，两边从此不可能撞名。

# ---- 网络 ----
# 容器内固定监听 80；这里是宿主机侧映射端口。
# 生成器会避开 8080 —— 那是本机 go run 后端的端口，两者可能同时运行。
STACK_HTTP_PORT=8090
STACK_TZ=Asia/Shanghai

# ---- 数据库 ----
STACK_MYSQL_PASSWORD=change-me
STACK_MYSQL_ROOT_PASSWORD=change-me

# ---- 应用安全密钥 ----
# 长度下限：aes_key 64 字符、phone_pepper 16、jwt_secret 32（见 internal/config/validate.go）
STACK_AES_KEY=change-me
STACK_PHONE_PEPPER=change-me
STACK_JWT_SECRET=change-me

# ---- 演示数据 ----
# cmd/seed 建管理员账号（13800000000）时使用
STACK_ADMIN_PASSWORD=change-me

# ---- 构建 ----
# 后端镜像用它做离线编译（GOPROXY=off）。用 `go env GOMODCACHE` 取，注意用正斜杠。
GOMODCACHE=
