{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediCore 预问诊结构化总结 v1",
  "type": "object",
  "required": [
    "chief_complaint",
    "present_illness",
    "past_history",
    "medications",
    "allergies",
    "red_flags",
    "possible_departments",
    "urgency"
  ],
  "properties": {
    "chief_complaint": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200,
      "description": "主诉：主要不适及持续时间"
    },
    "present_illness": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2000,
      "description": "现病史：起病、诱因、演变、伴随症状"
    },
    "past_history": {
      "type": "string",
      "maxLength": 2000,
      "description": "既往史：慢性病、手术、过敏等；无则填「无」"
    },
    "medications": {
      "type": "string",
      "maxLength": 1000,
      "description": "当前用药；无则填「无」"
    },
    "allergies": {
      "type": "string",
      "maxLength": 500,
      "description": "过敏史；无则填「否认药物过敏史」"
    },
    "red_flags": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 200 },
      "description": "危险信号：可能危及生命的症状，无则为空数组"
    },
    "possible_departments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 64 },
      "description": "建议就诊科室，供医生参考，不是诊断"
    },
    "urgency": {
      "type": "string",
      "enum": ["routine", "urgent", "emergency"],
      "description": "紧急程度"
    }
  }
}
