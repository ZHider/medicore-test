# 依赖（nub 的 isolated store 体积很大，绝不入库）
node_modules/
.store/

# 构建产物
dist/
dist-ssr/
*.exe
backend/bin/

# 本地配置与密钥：一律不进仓库。
# config.local.yaml 由 `go run ./cmd/genlocal` 生成。
.env
.env.*
!.env.example
*.local
*.local.yaml
*.local.yml
config.local.*

# 数据库导出。`nub run stack:dump` 默认写到 deploy/backup.sql。
# 里面含口令散列与加密后的手机号/身份证，绝不入库。
# 注意 docs/schema.sql 是 DDL 来源，必须被跟踪 —— 所以只忽略这些具体名字。
deploy/backup.sql
deploy/*.dump
deploy/dump*.sql
*.sqldump

# 日志
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# 测试与覆盖率
coverage.out
cover.out
*.cover

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.sw?

# Go
vendor/
